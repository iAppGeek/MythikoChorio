# Copy this file to .env and fill in your Supabase credentials.
# .env is gitignored — never commit real credentials.
#
# Find these values in your Supabase dashboard → Settings → API.
# Values are read at build time via react-native-config. After editing .env,
# rebuild the app (Metro hot-reload won't pick up native config changes).

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
